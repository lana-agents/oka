import Oka.Topology.VanKampen.Basic

/-!
# Seifert–van Kampen with a simply connected piece

If `X = U ∪ V` satisfies the hypotheses of the Seifert–van Kampen theorem
(`VanKampen.Hypotheses`) and `V` is simply connected, then `π₁(U, x₀) → π₁(X, x₀)` is surjective
with kernel the normal closure of the image of `π₁(U ∩ V, x₀)` (Hatcher, *Algebraic Topology*,
Thm. 1.20, the case `π₁(V) = 1`). This is how filling in a puncture is computed: for `V` a disc
around the puncture and `U` the punctured space, the kernel is generated by the loop around the
puncture.

## Main results

- `VanKampen.Hypotheses.fillEquiv`: `π₁(U, x₀) ⧸ ⟨⟨im π₁(U ∩ V, x₀)⟩⟩ ≃* π₁(X, x₀)`;
- `VanKampen.Hypotheses.ker_pieceMap_true`, `VanKampen.Hypotheses.pieceMap_true_surjective`.
-/

open Set

namespace VanKampen.Hypotheses

variable {X : Type*} [TopologicalSpace X] {U V : Set X} {x₀ : X} (h : Hypotheses U V x₀)

/-- The normal closure of the image of `π₁(U ∩ V, x₀)` in `π₁(U, x₀)`. -/
noncomputable def fillSubgroup :
    Subgroup (FundamentalGroup (piece U V true) ⟨x₀, mem_piece_of_mem_inter h.mem_inter true⟩) :=
  Subgroup.normalClosure (Set.range (interMap U V h.mem_inter true))

instance : (h.fillSubgroup).Normal := Subgroup.normalClosure_normal

/-- The homomorphisms on the two pieces: the quotient map on `U`, the trivial map on `V`. -/
noncomputable def fillFamily (b : Bool) :
    FundamentalGroup (piece U V b) ⟨x₀, mem_piece_of_mem_inter h.mem_inter b⟩ →*
      FundamentalGroup (piece U V true) ⟨x₀, mem_piece_of_mem_inter h.mem_inter true⟩ ⧸
        h.fillSubgroup :=
  match b with
  | true => QuotientGroup.mk' _
  | false => 1

theorem fillFamily_compat :
    (h.fillFamily true).comp (interMap U V h.mem_inter true) =
      (h.fillFamily false).comp (interMap U V h.mem_inter false) := by
  ext γ
  change (QuotientGroup.mk' h.fillSubgroup) (interMap U V h.mem_inter true γ) = 1
  rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  exact Subgroup.subset_normalClosure ⟨γ, rfl⟩

/-- The inverse of the filling isomorphism. -/
noncomputable def fillInv :
    FundamentalGroup X x₀ →*
      FundamentalGroup (piece U V true) ⟨x₀, mem_piece_of_mem_inter h.mem_inter true⟩ ⧸
        h.fillSubgroup :=
  lift h h.fillFamily h.fillFamily_compat

theorem fillInv_pieceMap_true
    (γ : FundamentalGroup (piece U V true) ⟨x₀, mem_piece_of_mem_inter h.mem_inter true⟩) :
    h.fillInv (pieceMap U V h.mem_inter true γ) = γ :=
  lift_pieceMap h h.fillFamily h.fillFamily_compat true γ

variable [SimplyConnectedSpace (piece U V false)]

theorem pieceMap_false_eq_one
    (γ : FundamentalGroup (piece U V false) ⟨x₀, mem_piece_of_mem_inter h.mem_inter false⟩) :
    pieceMap U V h.mem_inter false γ = 1 := by
  rw [Subsingleton.elim γ 1, map_one]

theorem fillSubgroup_le_ker : h.fillSubgroup ≤ (pieceMap U V h.mem_inter true).ker := by
  refine Subgroup.normalClosure_le_normal ?_
  rintro _ ⟨γ, rfl⟩
  rw [SetLike.mem_coe, MonoidHom.mem_ker]
  have := congrArg (fun φ ↦ φ γ) ((pieceMap_comp_interMap U V h.mem_inter true).trans
    (pieceMap_comp_interMap U V h.mem_inter false).symm)
  simp only [MonoidHom.comp_apply] at this
  rw [this, h.pieceMap_false_eq_one]

/-- The map from the quotient, induced by the inclusion `U ⊆ X`. -/
noncomputable def fillMap :
    FundamentalGroup (piece U V true) ⟨x₀, mem_piece_of_mem_inter h.mem_inter true⟩ ⧸
        h.fillSubgroup →* FundamentalGroup X x₀ :=
  QuotientGroup.lift _ (pieceMap U V h.mem_inter true) h.fillSubgroup_le_ker

/-- **Filling with a simply connected piece**:
`π₁(U, x₀) ⧸ ⟨⟨im π₁(U ∩ V, x₀)⟩⟩ ≃* π₁(X, x₀)`. -/
noncomputable def fillEquiv :
    FundamentalGroup (piece U V true) ⟨x₀, mem_piece_of_mem_inter h.mem_inter true⟩ ⧸
        h.fillSubgroup ≃* FundamentalGroup X x₀ :=
  MonoidHom.toMulEquiv h.fillMap h.fillInv
    (MonoidHom.ext fun q ↦ by
      induction q using QuotientGroup.induction_on with | H γ =>
      exact h.fillInv_pieceMap_true γ)
    (hom_ext h fun b ↦ by
      ext γ
      cases b with
      | true =>
        change h.fillMap (h.fillInv (pieceMap U V h.mem_inter true γ)) = _
        rw [h.fillInv_pieceMap_true]
        rfl
      | false =>
        change h.fillMap (h.fillInv (pieceMap U V h.mem_inter false γ)) =
          pieceMap U V h.mem_inter false γ
        rw [h.pieceMap_false_eq_one, map_one, map_one])

@[simp] theorem fillEquiv_mk
    (γ : FundamentalGroup (piece U V true) ⟨x₀, mem_piece_of_mem_inter h.mem_inter true⟩) :
    h.fillEquiv γ = pieceMap U V h.mem_inter true γ :=
  rfl

theorem pieceMap_true_surjective : Function.Surjective (pieceMap U V h.mem_inter true) := by
  intro γ
  obtain ⟨δ, hδ⟩ := h.fillEquiv.surjective γ
  induction δ using QuotientGroup.induction_on with | H δ =>
  exact ⟨δ, hδ⟩

theorem ker_pieceMap_true : (pieceMap U V h.mem_inter true).ker = h.fillSubgroup := by
  refine le_antisymm (fun γ hγ ↦ ?_) h.fillSubgroup_le_ker
  rw [MonoidHom.mem_ker] at hγ
  have : (γ : _ ⧸ h.fillSubgroup) = 1 :=
    h.fillEquiv.injective (by rw [fillEquiv_mk, hγ, map_one])
  exact (QuotientGroup.eq_one_iff γ).mp this

end VanKampen.Hypotheses
