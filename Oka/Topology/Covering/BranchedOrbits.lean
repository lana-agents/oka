import Oka.Topology.Covering.BranchedFill

/-!
# Orbits of the local monodromy are the points over a puncture

In the situation of `Oka/Topology/Covering/BranchedFill.lean` (a covering `X ∖ f⁻¹(S) → ℂ ∖ S`
with disc data `BranchedCover.DiscData`), the orbits on the fibre over the base point of the cyclic
group generated by the loop around `s ∈ S` correspond bijectively to the points `P ∈ X` with
`f P = s` (`BranchedCover.card_orbits_eq`): a point `e` of the fibre goes to the disc `V P`
containing the end of the lift from `e` of a path to a small circle around `s`. Together with
`BranchedCover.exists_fundamentalGroup_mulEquiv_freeGroup` this gives
`rank π₁(X) = d (|S| - 1) + 1 - #f⁻¹(S)`.

* `Complex.PuncturedPlane.exists_eq_zpow_circleArrow`: a loop at the base point of a small circle
  around `s`, inside a punctured disc around `s`, is a power of the circle (the punctured disc has
  infinite cyclic fundamental group, generated by any circle around `s`).
-/

open Set Metric Topology CategoryTheory Complex.PuncturedPlane Pi1.ReidemeisterSchreier

namespace Complex.PuncturedPlane

/-- The circle of an admissible radius as an element of the fundamental group. -/
noncomputable abbrev circleLoop {C : Set ℂ} {S : Finset ℂ} {s : ℂ} {r : ℝ}
    (h : Admissible C S s r) :
    FundamentalGroup (Region C S) (circleBase h) :=
  circleArrow h

/-- **Loops in a punctured disc are powers of a circle in it.** -/
theorem exists_eq_zpow_circleArrow {S : Finset ℂ} {s : ℂ} (hs : s ∈ S) {ρ r : ℝ}
    (hρ : ∀ s' ∈ S, s' ∈ ball s ρ → s' = s) (h : Admissible Set.univ S s r) (hr : r < ρ)
    (c : Path (circleBase h) (circleBase h)) (hc : ∀ t, (c t : ℂ) ∈ ball s ρ) :
    ∃ k : ℤ, (⟦c⟧ : FundamentalGroupoid.mk (circleBase h) ⟶ _) = circleLoop h ^ k := by
  classical
  have hB : Admissible (ball s ρ) {s} s r :=
    ⟨h.pos, closedBall_subset_ball hr, fun s' hs' _ ↦ Finset.mem_singleton.1 hs'⟩
  let ι : C(Region (ball s ρ) {s}, Region Set.univ S) :=
    ⟨fun w ↦ ⟨w.1, trivial, fun hw ↦ w.2.2 (by
      rw [Finset.mem_singleton]; exact hρ _ hw w.2.1)⟩, by fun_prop⟩
  have hne : ∀ y : Region Set.univ S, (y : ℂ) ∉ ({s} : Finset ℂ) := fun y hy ↦ y.2.2 (by
    rw [Finset.mem_singleton] at hy; rw [hy]; exact hs)
  let cB : Path (circleBase hB) (circleBase hB) :=
    { toFun := fun t ↦ ⟨c t, hc t, hne (c t)⟩
      continuous_toFun := (continuous_subtype_val.comp c.continuous).subtype_mk _
      source' := by
        apply Subtype.ext
        have h0 := congrArg (fun z : Region Set.univ S ↦ (z : ℂ)) c.source
        exact h0
      target' := by
        apply Subtype.ext
        have h1 := congrArg (fun z : Region Set.univ S ↦ (z : ℂ)) c.target
        exact h1 }
  obtain ⟨-, g, hg, hb⟩ := loopStatement 1 (ball s ρ) isOpen_ball (convex_ball s ρ) {s}
    (by
      intro y hy
      rw [Finset.coe_singleton, Set.mem_singleton_iff] at hy
      rw [hy]
      exact mem_ball_self (h.pos.trans hr)) (by simp) (circleBase hB)
  let s₀ : ({s} : Finset ℂ) := ⟨s, Finset.mem_singleton_self s⟩
  obtain ⟨w, hw⟩ := hb.2 (⟦cB⟧ : FundamentalGroupoid.mk (circleBase hB) ⟶ _)
  obtain ⟨k, rfl⟩ := FreeGroup.eq_of_zpow_of_subsingleton s₀ w
  rw [map_zpow, FreeGroup.lift_apply_of] at hw
  obtain ⟨r₀, h₀, δ₀, hδ₀⟩ := hg s₀
  have hgs : g s₀ = circleArrow hB := by
    rw [hδ₀, conj_circle_eq (convex_ball s ρ) h₀ hB δ₀ (𝟙 _)]
    simp [Groupoid.inv_eq_inv]
  refine ⟨k, ?_⟩
  have hmapc : FundamentalGroup.map ι (circleBase hB)
      (⟦cB⟧ : FundamentalGroupoid.mk (circleBase hB) ⟶ _) = ⟦c⟧ := by
    change Path.Homotopic.Quotient.mk (cB.map ι.continuous) = _
    have : cB.map ι.continuous = c := by ext t; rfl
    rw [this]
    rfl
  have hmapC : FundamentalGroup.map ι (circleBase hB) (circleArrow hB) = circleArrow h := by
    change Path.Homotopic.Quotient.mk ((circlePath hB).map ι.continuous) = _
    have : (circlePath hB).map ι.continuous = circlePath h := by ext t; rfl
    rw [this]
    rfl
  have h2 := congrArg (FundamentalGroup.map ι (circleBase hB)) hw
  rw [hgs, map_zpow, hmapC, hmapc] at h2
  exact h2.symm

end Complex.PuncturedPlane

namespace BranchedCover

universe u

variable {X : Type u} [TopologicalSpace X] {f : C(X, ℂ)} {S : Finset ℂ}
  (D : DiscData f S) (cov : IsCoveringMap (punctMap f S))

/-- **Lifts of paths in `B(s, σ s)` stay in one disc.** -/
theorem monodromy_mem_disc {s : ℂ} (hs : s ∈ S) {z z' : Region Set.univ S} (γ : Path z z')
    (hγ : ∀ t, (γ t : ℂ) ∈ ball s (D.σ s)) (e : punctMap f S ⁻¹' {z}) {P : X} (hP : f P = s)
    (he : e.1.1 ∈ D.V P) :
    (cov.monodromy (⟦γ⟧ : Path.Homotopic.Quotient z z') e).1.1 ∈ D.V P := by
  have h0 : γ.toContinuousMap 0 = punctMap f S e.1 := γ.source.trans e.2.symm
  set L := cov.liftPath γ.toContinuousMap e.1 h0
  have hL : ∀ t, f (L t).1 ∈ ball s (D.σ s) := fun t ↦ by
    have := congrFun (cov.liftPath_lifts γ.toContinuousMap e.1 h0) t
    have hfe : (punctMap f S (L t) : ℂ) = f (L t).1 := rfl
    rw [← hfe]
    simp only [Function.comp_apply] at this
    rw [this]
    exact hγ t
  have hPS : f P ∈ S := hP ▸ hs
  let T := {t | (L t).1 ∈ D.V P}
  have hTo : IsOpen T := (D.isOpen P hPS).preimage (continuous_subtype_val.comp L.continuous)
  have hTc : IsClosed T := by
    rw [← isOpen_compl_iff]
    have : Tᶜ = ⋃ Q ∈ {Q | f Q = s ∧ Q ≠ P}, {t | (L t).1 ∈ D.V Q} := by
      ext t
      simp only [mem_compl_iff, mem_setOf_eq, mem_iUnion, exists_prop, T]
      constructor
      · intro ht
        obtain ⟨Q, hQs, hQ⟩ := D.cover (L t).1 s hs (hL t)
        exact ⟨Q, ⟨hQs, fun hQP ↦ ht (hQP ▸ hQ)⟩, hQ⟩
      · rintro ⟨Q, ⟨hQs, hQP⟩, hQ⟩ ht
        exact Set.disjoint_left.mp (D.disjoint Q P (hQs ▸ hs) hPS hQP) hQ ht
    rw [this]
    exact isOpen_biUnion fun Q hQ ↦
      (D.isOpen Q (hQ.1 ▸ hs)).preimage (continuous_subtype_val.comp L.continuous)
  have h0T : (0 : unitInterval) ∈ T := by
    change (L 0).1 ∈ D.V P
    rw [cov.liftPath_zero]
    exact he
  have := IsClopen.eq_univ ⟨hTc, hTo⟩ ⟨0, h0T⟩
  exact (this ▸ mem_univ (1 : unitInterval) : (1 : unitInterval) ∈ T)

/-- The disc over `s` is determined by any of its points. -/
theorem eq_of_mem_disc {s : ℂ} {P Q : X} (hP : f P = s) (hQ : f Q = s) (hs : s ∈ S) {y : X}
    (hyP : y ∈ D.V P) (hyQ : y ∈ D.V Q) : P = Q := by
  by_contra hPQ
  exact Set.disjoint_left.mp (D.disjoint P Q (hP ▸ hs) (hQ ▸ hs) hPQ) hyP hyQ

/-- Every neighbourhood of the centre `P` of a disc `V P` contains points of `V P ∖ {P}`. -/
theorem exists_mem_disc_ne_of_mem {P : X} (hPS : f P ∈ S) {W : Set X} (hW : IsOpen W)
    (hPW : P ∈ W) : ∃ y, y ∈ D.V P \ {P} ∧ y ∈ W := by
  let e := D.e P hPS
  let W' : Set (D.V P) := Subtype.val ⁻¹' W
  have hW' : IsOpen W' := hW.preimage continuous_subtype_val
  let O : Set ℂ := Subtype.val '' (e '' W')
  have hO : IsOpen O :=
    isOpen_ball.isOpenMap_subtype_val _ (e.isOpenMap _ hW')
  have h0 : (0 : ℂ) ∈ O := ⟨e ⟨P, D.mem P hPS⟩, ⟨_, hPW, rfl⟩, D.e_center P hPS⟩
  obtain ⟨w, hwO, hw0⟩ := Filter.nonempty_of_mem (Filter.inter_mem
    (mem_nhdsWithin_of_mem_nhds (hO.mem_nhds h0)) (self_mem_nhdsWithin : {(0 : ℂ)}ᶜ ∈ 𝓝[≠] 0))
  obtain ⟨_, ⟨z, hz, rfl⟩, rfl⟩ := hwO
  refine ⟨z.1, ⟨z.2, fun hzP ↦ hw0 ?_⟩, hz⟩
  have : z = ⟨P, D.mem P hPS⟩ := Subtype.ext hzP
  rw [this]
  exact D.e_center P hPS

section Orbits

variable {x : Region Set.univ S} (ψ : FundamentalGroup (Region Set.univ S) x ≃* FreeGroup S)
  [MulAction (FreeGroup S) (punctMap f S ⁻¹' {x})]
  (hφ : ∀ (g : FreeGroup S) (e : punctMap f S ⁻¹' {x}), g • e = cov.monodromy (ψ.symm g) e)

include D cov hφ in
/-- **The `⟨x_s⟩`-orbits on the fibre are the points over `s`.** -/
theorem card_orbits_eq (hψ : ∀ s : S, IsLoopAround (ψ.symm (FreeGroup.of s)) s)
    (a : S) :
    Nat.card (MulAction.orbitRel.Quotient (Subgroup.zpowers (FreeGroup.of a))
      (punctMap f S ⁻¹' {x})) = Nat.card {P : X // f P = a} := by
  classical
  obtain ⟨s, hs⟩ := a
  obtain ⟨r, h, δ, hX⟩ := hψ ⟨s, hs⟩
  have hρ := D.σ_pos s hs
  set r' := min r (D.σ s / 2)
  have hr' : r' < D.σ s := lt_of_le_of_lt (min_le_right _ _) (half_lt_self hρ)
  have hr'ρ : r' < D.ρ s := lt_of_lt_of_le hr' (D.σ_le s hs)
  have h' : Admissible Set.univ S s r' := ⟨lt_min h.pos (half_pos hρ), subset_univ _,
    fun s' hs' hb ↦ h.isolated s' hs' (closedBall_subset_closedBall (min_le_left _ _) hb)⟩
  obtain ⟨β, hβ⟩ := circleArrow_eq_conj h h'
  let δ' : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk (circleBase h') := δ ≫ β
  let C' : FundamentalGroup (Region Set.univ S) (circleBase h') := circleArrow h'
  have hXs : ψ.symm (FreeGroup.of (⟨s, hs⟩ : S)) = conjArrow δ' C' := by
    rw [hX, hβ, conjArrow_apply]
    simp [δ', Groupoid.inv_eq_inv]
    rfl
  have hc'B : ((circleBase h' : Region Set.univ S) : ℂ) ∈ ball s (D.σ s) := by
    change s + (r' : ℂ) ∈ ball s (D.σ s)
    rw [mem_ball, dist_eq_norm, add_sub_cancel_left, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos h'.pos]
    exact hr'
  -- the disc of a fibre point
  let e₁ : (punctMap f S ⁻¹' {x}) → (punctMap f S ⁻¹' {circleBase h'}) := cov.monodromy δ'
  have hfz : ∀ z : punctMap f S ⁻¹' {circleBase h'}, f z.1.1 ∈ ball s (D.σ s) := fun z ↦ by
    have : (punctMap f S z.1 : ℂ) = f z.1.1 := rfl
    rw [← this, z.2]
    exact hc'B
  have hcov : ∀ e, ∃ P, f P = s ∧ (e₁ e).1.1 ∈ D.V P := fun e ↦ D.cover _ s hs (hfz _)
  let Φ : (punctMap f S ⁻¹' {x}) → {P : X // f P = s} := fun e ↦
    ⟨(hcov e).choose, (hcov e).choose_spec.1⟩
  have hΦ : ∀ e, (e₁ e).1.1 ∈ D.V (Φ e).1 := fun e ↦ (hcov e).choose_spec.2
  have hΦ_eq : ∀ e (P : {P : X // f P = s}), (e₁ e).1.1 ∈ D.V P.1 → Φ e = P := fun e P hP ↦
    Subtype.ext (eq_of_mem_disc D (Φ e).2 P.2 hs (hΦ e) hP)
  -- powers of the small circle keep the disc
  have hpow : ∀ (k : ℤ) (z : punctMap f S ⁻¹' {circleBase h'}) (P : X), f P = s →
      z.1.1 ∈ D.V P → (cov.monodromy (C' ^ k) z).1.1 ∈ D.V P := by
    intro k z P hP hz
    have hk : (⟦(circlePath h').zpowLoop k⟧ : Path.Homotopic.Quotient _ _) = C' ^ k :=
      (circlePath h').class_zpowLoop k
    rw [← hk]
    refine monodromy_mem_disc D cov hs _ (fun t ↦ ?_) z hP hz
    obtain ⟨t', ht'⟩ := (circlePath h').mem_range_zpowLoop k t
    rw [← ht', coe_circlePath, mem_ball, dist_eq_norm, norm_circleFun_sub s h'.pos.le]
    exact hr'
  -- the action of `x_s^k` read through `δ'`
  have hact : ∀ (k : ℤ) e,
      e₁ (FreeGroup.of (⟨s, hs⟩ : S) ^ k • e) = cov.monodromy (C' ^ k) (e₁ e) := by
    intro k e
    rw [hφ, map_zpow, hXs, ← map_zpow, conjArrow_apply]
    change cov.monodromy δ' (cov.monodromy (δ' ≫ (C' ^ k) ≫ Groupoid.inv δ') e) = _
    rw [← cov.monodromy_trans_apply, ← cov.monodromy_trans_apply]
    change cov.monodromy ((δ' ≫ (C' ^ k) ≫ Groupoid.inv δ') ≫ δ') e =
      cov.monodromy (δ' ≫ (C' ^ k)) e
    congr 1
    simp only [Groupoid.inv_eq_inv, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
  have he₁inj : Function.Injective e₁ := (cov.monodromy_bijective _).1
  -- `Φ` is constant on orbits
  have hconst : ∀ (k : ℤ) e, Φ (FreeGroup.of (⟨s, hs⟩ : S) ^ k • e) = Φ e := fun k e ↦ by
    apply hΦ_eq
    rw [hact]
    exact hpow k _ _ (Φ e).2 (hΦ e)
  let Ψ : MulAction.orbitRel.Quotient (Subgroup.zpowers (FreeGroup.of (⟨s, hs⟩ : S)))
      (punctMap f S ⁻¹' {x}) → {P : X // f P = s} :=
    Quotient.lift Φ (fun e e' hee' ↦ by
      obtain ⟨⟨g, hg⟩, rfl⟩ := MulAction.mem_orbit_iff.mp (MulAction.orbitRel_apply.mp hee')
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
      exact hconst k e')
  have hinj : Function.Injective Ψ := by
    intro o o'
    induction o using Quotient.inductionOn with | h e =>
    induction o' using Quotient.inductionOn with | h e' =>
    intro hee'
    change Φ e = Φ e' at hee'
    have hPS : f (Φ e).1 ∈ S := by rw [(Φ e).2]; exact hs
    have hnotP : ∀ y : punctMap f S ⁻¹' {circleBase h'}, y.1.1 ≠ (Φ e).1 :=
      fun y hy ↦ y.1.2 (hy ▸ hPS)
    have h1 : (e₁ e).1.1 ∈ D.V (Φ e).1 \ {(Φ e).1} := ⟨hΦ e, hnotP _⟩
    have h2 : (e₁ e').1.1 ∈ D.V (Φ e).1 \ {(Φ e).1} := ⟨hee' ▸ hΦ e', hnotP _⟩
    obtain ⟨q, hq⟩ := (VanKampen.isPathConnected_diff_of_disc (D.e _ hPS) (D.mem _ hPS)
      (D.e_center _ hPS)).joinedIn _ h1 _ h2
    have hqE : ∀ t, f (q t) ∉ S := fun t hS ↦ (hq t).2 (D.eq_of_mem _ hPS _ (hq t).1 hS)
    let q' : Path (e₁ e).1 (e₁ e').1 :=
      { toFun := fun t ↦ ⟨q t, hqE t⟩
        continuous_toFun := q.continuous.subtype_mk _
        source' := Subtype.ext q.source
        target' := Subtype.ext q.target }
    let pq : Path (circleBase h') (circleBase h') :=
      (q'.map (punctMap f S).continuous).cast (e₁ e).2.symm (e₁ e').2.symm
    have hpq : ∀ t, (pq t : ℂ) ∈ ball s (D.ρ s) := fun t ↦ by
      change f (q t) ∈ _
      have := D.mapsTo _ hPS _ (hq t).1
      rwa [(Φ e).2] at this
    obtain ⟨k, hk⟩ := exists_eq_zpow_circleArrow hs (D.ρ_isolated s hs) h' hr'ρ pq hpq
    have hk' : (⟦pq⟧ : Path.Homotopic.Quotient _ _) = C' ^ k := hk
    have hmon : cov.monodromy (C' ^ k) (e₁ e) = e₁ e' := by
      apply cov.monodromy_eq_of_map_eq (⟦q'⟧ : Path.Homotopic.Quotient _ _)
      rw [← hk']
      rfl
    have hfin : FreeGroup.of (⟨s, hs⟩ : S) ^ k • e = e' :=
      he₁inj ((hact k e).trans hmon)
    apply Quotient.sound
    refine MulAction.orbitRel_apply.mpr (MulAction.mem_orbit_iff.mpr
      ⟨⟨_, Subgroup.zpow_mem_zpowers _ (-k)⟩, ?_⟩)
    change FreeGroup.of (⟨s, hs⟩ : S) ^ (-k) • e' = e
    rw [← hfin, smul_smul, ← zpow_add, neg_add_cancel, zpow_zero, one_smul]
  have hsurj : Function.Surjective Ψ := by
    rintro ⟨P, hP⟩
    have hPS : f P ∈ S := by rw [hP]; exact hs
    obtain ⟨y, hy, hyB⟩ := exists_mem_disc_ne_of_mem D hPS (isOpen_ball.preimage f.continuous)
      (show f P ∈ ball s (D.σ s) by rw [hP]; exact mem_ball_self (D.σ_pos s hs))
    have hyS : f y ∉ S := fun hS ↦ hy.2 (D.eq_of_mem P hPS y hy.1 hS)
    let y' : Punct f S := ⟨y, hyS⟩
    have hB' : Admissible (ball s (D.σ s)) {s} s r' :=
      ⟨h'.pos, closedBall_subset_ball hr', fun s' hs' _ ↦ Finset.mem_singleton.1 hs'⟩
    haveI := pathConnectedSpace_region_single (convex_ball s (D.σ s)) hB'
    let ι : C(Region (ball s (D.σ s)) {s}, Region Set.univ S) :=
      ⟨fun w ↦ ⟨w.1, trivial, fun hw ↦ w.2.2 (by
        rw [Finset.mem_singleton]; exact D.ρ_isolated s hs _ hw
          (ball_subset_ball (D.σ_le s hs) w.2.1))⟩, by fun_prop⟩
    have hne : f y ∉ ({s} : Finset ℂ) := fun h ↦ hyS (by
      rw [Finset.mem_singleton] at h; rw [h]; exact hs)
    let yB : Region (ball s (D.σ s)) {s} := ⟨f y, hyB, hne⟩
    let γB := PathConnectedSpace.somePath yB (circleBase hB')
    let γ : Path (punctMap f S y') (circleBase h') := γB.map ι.continuous
    have hγ : ∀ t, (γ t : ℂ) ∈ ball s (D.σ s) := fun t ↦ (γB t).2.1
    let z := cov.monodromy (⟦γ⟧ : Path.Homotopic.Quotient _ _)
      (⟨y', rfl⟩ : punctMap f S ⁻¹' {punctMap f S y'})
    have hz : z.1.1 ∈ D.V P := monodromy_mem_disc D cov hs γ hγ ⟨y', rfl⟩ hP hy.1
    refine ⟨Quotient.mk _ (cov.monodromy (Groupoid.inv δ') z), ?_⟩
    change Φ _ = ⟨P, hP⟩
    apply hΦ_eq
    have hzz : e₁ (cov.monodromy (Groupoid.inv δ') z) = z := by
      change cov.monodromy δ' (cov.monodromy (Groupoid.inv δ') z) = z
      rw [← cov.monodromy_trans_apply]
      change cov.monodromy (Groupoid.inv δ' ≫ δ') z = z
      rw [Groupoid.inv_comp]
      exact congrFun cov.monodromy_refl z
    rw [hzz]
    exact hz
  exact Nat.card_congr (Equiv.ofBijective Ψ ⟨hinj, hsurj⟩)

include D cov hφ in
/-- **`π₁` of a finite branched covering of the plane**: with `d` sheets over `ℂ ∖ S`, `π₁(X, e₀)`
is free of rank `d (|S| - 1) + 1 - #f⁻¹(S)`. -/
theorem exists_fundamentalGroup_mulEquiv_freeGroup_card [T1Space X]
    [PathConnectedSpace (Punct f S)] [Finite (punctMap f S ⁻¹' {x})]
    (hψ : ∀ s : S, IsLoopAround (ψ.symm (FreeGroup.of s)) s) (e₀ : punctMap f S ⁻¹' {x}) :
    ∃ (ι : Type u) (_ : Finite ι), Nonempty (FundamentalGroup X e₀.1.1 ≃* FreeGroup ι) ∧
      Nat.card ι + Nat.card (punctMap f S ⁻¹' {x}) + Nat.card {P : X // f P ∈ S} =
        Nat.card (punctMap f S ⁻¹' {x}) * Nat.card S + 1 := by
  obtain ⟨ι, hι, hiso, hcard⟩ :=
    exists_fundamentalGroup_mulEquiv_freeGroup D cov ψ hφ hψ e₀
  refine ⟨ι, hι, hiso, ?_⟩
  haveI : Finite {P : X // f P ∈ S} := D.finite.to_subtype
  have hsum : ∑ a : S, Nat.card (MulAction.orbitRel.Quotient (Subgroup.zpowers (FreeGroup.of a))
      (punctMap f S ⁻¹' {x})) = Nat.card {P : X // f P ∈ S} := by
    rw [Finset.sum_congr rfl fun a _ ↦ card_orbits_eq D cov ψ hφ hψ a]
    haveI : ∀ a : S, Finite {P : X // f P = a} := fun a ↦
      (D.finite.subset fun P (hP : f P = a) ↦ by
        change f P ∈ S; rw [hP]; exact a.2).to_subtype
    haveI : ∀ a : S, Fintype {P : X // f P = a} := fun a ↦ Fintype.ofFinite _
    rw [← Nat.card_sigma]
    exact Nat.card_congr
      { toFun := fun p ↦ ⟨p.2.1, by rw [p.2.2]; exact p.1.2⟩
        invFun := fun P ↦ ⟨⟨f P.1, P.2⟩, P.1, rfl⟩
        left_inv := by
          rintro ⟨⟨a, ha⟩, P, hP⟩
          dsimp only at hP
          subst hP
          rfl
        right_inv := fun _ ↦ rfl }
  rw [← hsum]
  exact hcard

end Orbits

end BranchedCover
