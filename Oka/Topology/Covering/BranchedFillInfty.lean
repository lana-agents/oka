import Oka.Topology.Covering.BranchedOrbits
import Oka.Topology.VanKampen.ExteriorLoops

/-!
# Filling the point at infinity of a branched covering of `ℂ ∖ {0, 1}`

Let `f : X → ℂ` be a branched covering of the plane, unramified over `ℂ ∖ {0, 1}`, with disc
data at the points over `{0, 1}` (`BranchedCover.DiscData`), and let `j : X → Y` be an embedding
onto `Y ∖ {p}` for a point `p` of a `T₁` space `Y`, such that `p` has a disc neighbourhood `V`
on which `f` is "near `∞`" (`BranchedCover.InftyData`): `f(V ∖ {p}) ⊆ {z | R₀ < ‖z - 1/2‖}` for
some `R₀ > 1/2`, and `f⁻¹ {z | R₁ < ‖z - 1/2‖} ⊆ V` for some `R₁`. This is the topological
situation of a compact curve `Y` with a finite map to `ℙ¹`, étale over `ℙ¹ ∖ {0, 1, ∞}`, with
exactly one point `p` over `∞`.

Choose the geometric free basis `x₀, x₁` of `π₁(ℂ ∖ {0, 1}, x)` of
`Complex.exists_mulEquiv_freeGroup_zero_one` (loops around `0` and `1`, with `x₀ x₁` the circle
of radius `R > max R₀ R₁` around `1/2`). Then the kernel of
`π₁(X ∖ f⁻¹{0, 1}, e₀) → π₁(Y, e₀)` is the preimage, under `π₁(X ∖ f⁻¹{0,1}, e₀) ≃* Stab(e₀)`,
of the subgroup generated by pi1's cusp subgroup and the normal closure of the elements of the
stabiliser conjugate in `F(x₀, x₁)` to a power of `x₀ x₁`
(`BranchedCover.ker_eq_comap_cuspSubgroup_sup_infty`).

## Proof

`VanKampen.fill_finite` with the finite set `{p} ∪ j(f⁻¹{0,1})`: the kernel is the normal closure
of the loops in the discs. The loops in the discs over `{0, 1}` give the cusp subgroup
(`BranchedCover.ker_eq_comap_cuspSubgroup`). A loop in `V ∖ {p}` maps into the exterior
`{R₀ < ‖z - 1/2‖}`, hence is conjugate to a power of `x₀ x₁`
(`Complex.PuncturedPlane.ZeroOne.exists_eq_conjArrow_zpow`); conversely a conjugate of a power of
`x₀ x₁` in the stabiliser lifts to a conjugate of the closed lift of a power of the circle of
radius `R > R₁`, which lies in `f⁻¹ {R₁ < ‖z - 1/2‖} ⊆ V`.
-/

open Set Metric Topology CategoryTheory Complex.PuncturedPlane Complex.PuncturedPlane.ZeroOne
  Pi1.ReidemeisterSchreier

namespace BranchedCover

universe u v

section Fill

variable {X : Type u} {Y : Type v} [TopologicalSpace X] [TopologicalSpace Y]

/-- An embedding restricts to a homeomorphism of `s` with its image. -/
noncomputable def imageHomeo {j : X → Y} (hj : IsEmbedding j) (s : Set X) : j '' s ≃ₜ s :=
  ((hj.comp IsEmbedding.subtypeVal).toHomeomorph.trans
    (Homeomorph.setCongr (by rw [range_comp, Subtype.range_coe]))).symm

theorem apply_imageHomeo {j : X → Y} (hj : IsEmbedding j) (s : Set X) (y : j '' s) :
    j (imageHomeo hj s y) = y := by
  conv_rhs => rw [← (imageHomeo hj s).symm_apply_apply y]
  rfl

/-- **Disc data at infinity** for `f : X → ℂ` and `j : X → Y`: a disc neighbourhood `V` of `p`
whose points other than `p` are mapped by `f` into the exterior `{z | R₀ < ‖z - 1/2‖}`,
`R₀ > 1/2`, and which contains the image of `f⁻¹ {z | R₁ < ‖z - 1/2‖}`. -/
structure InftyData (f : C(X, ℂ)) (j : C(X, Y)) (p : Y) where
  /-- The disc neighbourhood of `p`. -/
  V : Set Y
  /-- The homeomorphism with the unit disc. -/
  e : V ≃ₜ ball (0 : ℂ) 1
  isOpen : IsOpen V
  mem : p ∈ V
  e_center : (e ⟨p, mem⟩ : ℂ) = 0
  /-- The radius of the exterior containing `f(V ∖ {p})`. -/
  R₀ : ℝ
  half_lt : 1 / 2 < R₀
  mapsTo : ∀ u, j u ∈ V → R₀ < ‖f u - 1 / 2‖
  /-- The radius of an exterior whose preimage lies in `V`. -/
  R₁ : ℝ
  cover : ∀ u, R₁ < ‖f u - 1 / 2‖ → j u ∈ V

variable {f : C(X, ℂ)} {j : C(X, Y)} {p : Y}

/-- The inclusion `X ∖ f⁻¹{0, 1} → Y`. -/
def punctIncl (f : C(X, ℂ)) (j : C(X, Y)) : C(Punct f ({0, 1} : Finset ℂ), Y) :=
  j.comp ⟨Subtype.val, continuous_subtype_val⟩

theorem conjLoops_punctIncl_image (hj : IsEmbedding j) (V : Set X)
    (w₀ : Punct f ({0, 1} : Finset ℂ)) :
    VanKampen.conjLoops (punctIncl f j) (j '' V) w₀ = VanKampen.conjLoops Subtype.val V w₀ := by
  ext g
  simp only [VanKampen.conjLoops, mem_setOf_eq]
  refine exists_congr fun w ↦ exists_congr fun γ ↦ exists_congr fun c ↦ and_congr_left' ?_
  refine forall_congr' fun t ↦ ?_
  exact hj.injective.mem_set_image

/-- **Filling `f⁻¹{0, 1}` and the point at infinity**: `π₁(X ∖ f⁻¹{0, 1}) → π₁(Y)` is surjective
with kernel the normal closure of the loops in the discs over `{0, 1}` and of the loops in the
disc at infinity. -/
theorem fill_infty [T1Space Y] [PathConnectedSpace (Punct f ({0, 1} : Finset ℂ))]
    (D : DiscData f ({0, 1} : Finset ℂ)) (hj : IsEmbedding j) (hrange : range j = {p}ᶜ)
    (I : InftyData f j p) (e₀ : Punct f ({0, 1} : Finset ℂ)) :
    Function.Surjective (FundamentalGroup.map (punctIncl f j) e₀) ∧
      (FundamentalGroup.map (punctIncl f j) e₀).ker =
        Subgroup.normalClosure ((⋃ P ∈ {P | f P ∈ ({0, 1} : Finset ℂ)},
          VanKampen.conjLoops Subtype.val (D.V P) e₀) ∪
            VanKampen.conjLoops (punctIncl f j) I.V e₀) := by
  classical
  haveI : Nonempty X := ⟨e₀.1⟩
  have hoj : IsOpenEmbedding j := ⟨hj, by rw [hrange]; exact isOpen_compl_singleton⟩
  set T := {P | f P ∈ ({0, 1} : Finset ℂ)}
  set Z : Set Y := insert p (j '' T)
  let VY : Y → Set Y := fun q ↦ if q = p then I.V else j '' D.V (Function.invFun j q)
  have hinv : ∀ P, Function.invFun j (j P) = P := Function.leftInverse_invFun hj.injective
  have hpj : ∀ P, j P ≠ p := fun P h ↦ by
    have : j P ∈ range j := mem_range_self P
    rw [hrange, h] at this
    exact this rfl
  have hVj : ∀ P, VY (j P) = j '' D.V P := fun P ↦ by simp [VY, hpj P, hinv P]
  have hVp : VY p = I.V := by simp [VY]
  have hZT : ∀ q ∈ Z, q ≠ p → f (Function.invFun j q) ∈ ({0, 1} : Finset ℂ) := by
    rintro q (rfl | ⟨P, hP, rfl⟩) hq
    · exact absurd rfl hq
    · rwa [hinv]
  have hVo : ∀ q ∈ Z, IsOpen (VY q) := by
    rintro q (rfl | ⟨P, hP, rfl⟩)
    · rw [hVp]; exact I.isOpen
    · rw [hVj]; exact hoj.isOpenMap _ (D.isOpen P hP)
  have hPV : ∀ q ∈ Z, q ∈ VY q := by
    rintro q (rfl | ⟨P, hP, rfl⟩)
    · rw [hVp]; exact I.mem
    · rw [hVj]; exact mem_image_of_mem j (D.mem P hP)
  let e : ∀ q ∈ Z, VY q ≃ₜ ball (0 : ℂ) 1 := fun q hq ↦
    if hqp : q = p then (Homeomorph.setCongr (by rw [hqp, hVp])).trans I.e
    else (Homeomorph.setCongr (show VY q = j '' D.V (Function.invFun j q) by simp [VY, hqp])).trans
      ((imageHomeo hj _).trans (D.e _ (hZT q hq hqp)))
  have he : ∀ q (hq : q ∈ Z), (e q hq ⟨q, hPV q hq⟩ : ℂ) = 0 := by
    intro q hq
    by_cases hqp : q = p
    · subst hqp
      simp only [e, dif_pos]
      exact I.e_center
    · simp only [e, dif_neg hqp]
      set Q := Function.invFun j q
      have hQ := hZT q hq hqp
      set y := imageHomeo hj (D.V Q) ⟨q, by simpa [VY, hqp] using hPV q hq⟩
      have hjQ : j Q = q := Function.invFun_eq (by
        obtain ⟨P, -, hP⟩ := hq.resolve_left hqp
        exact ⟨P, hP⟩)
      have hy : (y : X) = Q :=
        hj.injective ((apply_imageHomeo hj (D.V Q) _).trans hjQ.symm)
      have : y = ⟨Q, D.mem Q hQ⟩ := Subtype.ext hy
      change (D.e Q hQ y : ℂ) = 0
      rw [this]
      exact D.e_center Q hQ
  have hVZ : ∀ q ∈ Z, ∀ q' ∈ Z, q' ∈ VY q → q' = q := by
    rintro q (rfl | ⟨P, hP, rfl⟩) q' (rfl | ⟨P', hP', rfl⟩) hq'
    · rfl
    · rw [hVp] at hq'
      have h1 := I.mapsTo P' hq'
      have h2 := norm_sub_half_eq_of_mem hP'
      linarith [I.half_lt]
    · rw [hVj] at hq'
      obtain ⟨u, -, hu⟩ := hq'
      exact absurd hu (hpj u)
    · rw [hVj, hj.injective.mem_set_image] at hq'
      rw [D.eq_of_mem P hP P' hq' hP']
  have hrange' : range (punctIncl f j) = Zᶜ := by
    ext y
    simp only [mem_range, mem_compl_iff, Z, mem_insert_iff, mem_image, not_or, not_exists,
      not_and]
    constructor
    · rintro ⟨u, rfl⟩
      refine ⟨hpj u.1, fun P hP hPu ↦ u.2 ?_⟩
      exact (hj.injective hPu : P = u.1) ▸ hP
    · rintro ⟨hyp, hy⟩
      have : y ∈ range j := by rw [hrange]; exact hyp
      obtain ⟨u, rfl⟩ := this
      exact ⟨⟨u, fun hu ↦ hy u hu rfl⟩, rfl⟩
  have hemb : IsEmbedding (punctIncl f j) := hj.comp IsEmbedding.subtypeVal
  obtain ⟨hs, hk⟩ := VanKampen.fill_finite (punctIncl f j) hemb Z ((D.finite.image j).insert p)
    hrange' VY hVo hPV e he hVZ e₀
  refine ⟨hs, hk.trans (congrArg _ ?_)⟩
  rw [biUnion_insert, biUnion_image, hVp, union_comm]
  congr 1
  refine iUnion₂_congr fun P _ ↦ ?_
  rw [hVj, conjLoops_punctIncl_image hj]

end Fill

/-- The loop `x₀ x₁` of `F({0, 1})`, the inverse of the loop around `∞`. -/
noncomputable abbrev loop01 : FreeGroup ({0, 1} : Finset ℂ) :=
  FreeGroup.of ⟨0, by simp⟩ * FreeGroup.of ⟨1, by simp⟩

section Main

variable {X : Type u} {Y : Type v} [TopologicalSpace X] [TopologicalSpace Y]
  {f : C(X, ℂ)} {j : C(X, Y)} {p : Y} (I : InftyData f j p)
  (cov : IsCoveringMap (punctMap f ({0, 1} : Finset ℂ))) {x : X01}
  (ψ : FundamentalGroup X01 x ≃* FreeGroup ({0, 1} : Finset ℂ))
  [MulAction (FreeGroup ({0, 1} : Finset ℂ)) (punctMap f ({0, 1} : Finset ℂ) ⁻¹' {x})]
  (hφ : ∀ (g : FreeGroup ({0, 1} : Finset ℂ)) (e : punctMap f ({0, 1} : Finset ℂ) ⁻¹' {x}),
    g • e = cov.monodromy (ψ.symm g) e)

/-- The image in `π₁(ℂ ∖ {0, 1}, x)` of a loop `γ c γ⁻¹` with `c` in the disc at infinity is
conjugate to a power of `x₀ x₁`. -/
theorem exists_eq_conj_of_mem_conjLoops_infty {R : ℝ} (hR : 1 / 2 < R) (hR₀ : I.R₀ < R)
    (hψ : ∃ δ : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk (bigBase hR),
      ψ.symm loop01 = δ ≫ bigArrow hR ≫ Groupoid.inv δ)
    (e₀ : punctMap f ({0, 1} : Finset ℂ) ⁻¹' {x})
    {g : FundamentalGroup (Punct f ({0, 1} : Finset ℂ)) e₀.1}
    (hg : g ∈ VanKampen.conjLoops (punctIncl f j) I.V e₀.1) :
    ∃ (G : FreeGroup ({0, 1} : Finset ℂ)) (k : ℤ),
      (cov.fundamentalGroupEquivFreeStabilizer ψ hφ e₀ g : FreeGroup ({0, 1} : Finset ℂ)) =
        G * loop01 ^ k * G⁻¹ := by
  obtain ⟨w, γ, c, hc, rfl⟩ := hg
  let pc : Path (punctMap f _ w) (punctMap f _ w) := c.map (punctMap f _).continuous
  have hpc : ∀ t, I.R₀ < ‖(pc t : ℂ) - 1 / 2‖ := fun t ↦ I.mapsTo _ (hc t)
  obtain ⟨k, α, hk⟩ := exists_eq_conjArrow_zpow I.half_lt hR hR₀ hψ pc hpc
  set Xs := ψ.symm loop01
  have hx : FundamentalGroupoid.mk x = FundamentalGroupoid.mk (punctMap f _ e₀.1) :=
    congrArg FundamentalGroupoid.mk e₀.2.symm
  let Dd : FundamentalGroup X01 x :=
    eqToHom hx ≫ (FundamentalGroupoid.map (punctMap f _)).map γ ≫ α
  have hmap : FundamentalGroup.mapOfEq ⟨punctMap f _, cov.continuous⟩ e₀.2
      (γ ≫ ⟦c⟧ ≫ Groupoid.inv γ) = Dd⁻¹ * Xs ^ k * Dd := by
    change eqToHom hx ≫ (FundamentalGroupoid.map (punctMap f _)).map
      (γ ≫ ⟦c⟧ ≫ Groupoid.inv γ) ≫ eqToHom hx.symm = Dd ≫ (Xs ^ k) ≫ Groupoid.inv Dd
    have hc' : (FundamentalGroupoid.map (punctMap f _)).map
        (⟦c⟧ : FundamentalGroupoid.mk w ⟶ FundamentalGroupoid.mk w) =
          α ≫ (Xs ^ k) ≫ Groupoid.inv α := hk.trans (conjArrow_apply _ _)
    rw [Functor.map_comp, Functor.map_comp, hc', Groupoid.inv_eq_inv γ, Functor.map_inv]
    simp only [Dd, Groupoid.inv_eq_inv, IsIso.inv_comp, inv_eqToHom, Category.assoc]
    erw [Category.assoc, Category.assoc, Category.assoc, Category.assoc]
    rfl
  refine ⟨(ψ Dd)⁻¹, k, ?_⟩
  rw [coe_fundamentalGroupEquivFreeStabilizer, hmap, map_mul, map_mul, map_inv, map_zpow,
    MulEquiv.apply_symm_apply, inv_inv]

/-- A conjugate of a power of `x₀ x₁` lying in the stabiliser comes from a loop `γ c γ⁻¹` with
`c` in the disc at infinity. -/
theorem mem_conjLoops_infty_of_eq {R : ℝ} (hR : 1 / 2 < R) (hR₁ : I.R₁ < R)
    (hψ : ∃ δ : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk (bigBase hR),
      ψ.symm loop01 = δ ≫ bigArrow hR ≫ Groupoid.inv δ)
    (e₀ : punctMap f ({0, 1} : Finset ℂ) ⁻¹' {x})
    {g : FundamentalGroup (Punct f ({0, 1} : Finset ℂ)) e₀.1}
    {G : FreeGroup ({0, 1} : Finset ℂ)} {k : ℤ}
    (hg : (cov.fundamentalGroupEquivFreeStabilizer ψ hφ e₀ g : FreeGroup ({0, 1} : Finset ℂ)) =
      G * loop01 ^ k * G⁻¹) :
    g ∈ VanKampen.conjLoops (punctIncl f j) I.V e₀.1 := by
  obtain ⟨δ, hX⟩ := hψ
  let C' : FundamentalGroup X01 (bigBase hR) := bigArrow hR
  set Gh := ψ.symm G
  let A : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk (bigBase hR) :=
    Groupoid.inv Gh ≫ δ
  -- the image of `g` in `π₁(ℂ ∖ {0, 1}, x)`
  have hpg : FundamentalGroup.mapOfEq ⟨punctMap f _, cov.continuous⟩ e₀.2 g =
      A ≫ (C' ^ k) ≫ Groupoid.inv A := by
    have h1 : FundamentalGroup.mapOfEq ⟨punctMap f _, cov.continuous⟩ e₀.2 g =
        Gh * ψ.symm loop01 ^ k * Gh⁻¹ := by
      apply ψ.injective
      rw [← coe_fundamentalGroupEquivFreeStabilizer cov ψ hφ, hg, map_mul, map_mul, map_zpow,
        map_inv, MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply]
    have h2 : ψ.symm loop01 = Complex.PuncturedPlane.conjArrow δ C' := by
      rw [hX, conjArrow_apply]
    rw [h1, h2, ← map_zpow, conjArrow_apply]
    change Groupoid.inv Gh ≫ (δ ≫ (C' ^ k) ≫ Groupoid.inv δ) ≫ Gh = _
    simp only [A, Groupoid.inv_eq_inv, IsIso.inv_comp, IsIso.inv_inv, Category.assoc]
  clear_value A
  -- the lift `e₁` of the base point of the circle and the closed lift of `C'ᵏ`
  set e₁ := cov.monodromy A e₀
  have hstab : cov.monodromy (FundamentalGroup.mapOfEq ⟨punctMap f _, cov.continuous⟩ e₀.2 g)
      e₀ = e₀ :=
    (cov.mem_monodromyStabilizer_iff_mem_range e₀ _).mpr ⟨g, rfl⟩
  have hinv : cov.monodromy (Groupoid.inv A) e₁ = e₀ := by
    rw [← cov.monodromy_trans_apply]
    change cov.monodromy (A ≫ Groupoid.inv A) e₀ = e₀
    rw [Groupoid.comp_inv]
    exact congrFun cov.monodromy_refl e₀
  have hmono : cov.monodromy (C' ^ k) e₁ = e₁ := by
    apply (cov.monodromy_bijective (Groupoid.inv A)).1
    rw [hinv, ← cov.monodromy_trans_apply, ← cov.monodromy_trans_apply]
    change cov.monodromy (A ≫ (C' ^ k) ≫ Groupoid.inv A) e₀ = e₀
    rw [← hpg]
    exact hstab
  let cpk : Path (bigBase hR) (bigBase hR) := (bigLoop hR).zpowLoop k
  have hcpk : (⟦cpk⟧ : FundamentalGroupoid.mk (bigBase hR) ⟶ _) = C' ^ k :=
    (bigLoop hR).class_zpowLoop k
  have hcpkB : ∀ t, I.R₁ < ‖(cpk t : ℂ) - 1 / 2‖ := by
    intro t
    obtain ⟨t', ht'⟩ := (bigLoop hR).mem_range_zpowLoop k t
    rw [← ht']
    exact lt_norm_bigLoop_sub hR hR₁ t'
  have h0 : cpk.toContinuousMap 0 = punctMap f _ e₁.1 := cpk.source.trans e₁.2.symm
  let L₀ := cov.liftPath cpk.toContinuousMap e₁.1 h0
  have hL₀ : ∀ t, punctMap f _ (L₀ t) = cpk t := fun t ↦
    congrFun (cov.liftPath_lifts cpk.toContinuousMap e₁.1 h0) t
  have hL₁ : L₀ 1 = e₁.1 := by
    have : (cov.monodromy (⟦cpk⟧ : Path.Homotopic.Quotient _ (bigBase hR)) e₁).1 = L₀ 1 := rfl
    rw [← this]
    change (cov.monodromy (⟦cpk⟧ : FundamentalGroupoid.mk (bigBase hR) ⟶ _) e₁).1 = e₁.1
    rw [hcpk]
    exact congrArg Subtype.val hmono
  let L : Path e₁.1 e₁.1 := ⟨L₀, cov.liftPath_zero .., hL₁⟩
  have hall : ∀ t, punctIncl f j (L t) ∈ I.V := fun t ↦ by
    refine I.cover _ ?_
    have := hL₀ t
    have hfe : (punctMap f _ (L₀ t) : ℂ) = f (L₀ t).1 := rfl
    change I.R₁ < ‖f (L₀ t).1 - 1 / 2‖
    rw [← hfe, this]
    exact hcpkB t
  -- `g` is the lift `Ã ≫ L ≫ Ã⁻¹`
  let Ã : FundamentalGroupoid.mk e₀.1 ⟶ FundamentalGroupoid.mk e₁.1 := cov.liftPathQuotient A e₀
  have he₀ : punctMap f _ e₀.1 = x := e₀.2
  have he₁ : punctMap f _ e₁.1 = bigBase hR := e₁.2
  have hgL : g = Ã ≫ ⟦L⟧ ≫ Groupoid.inv Ã := by
    apply cov.mapOfEq_injective e₀
    rw [hpg]
    have hÃ : (FundamentalGroupoid.map ⟨punctMap f _, cov.continuous⟩).map Ã =
        eqToHom (congrArg FundamentalGroupoid.mk he₀) ≫ A ≫
          eqToHom (congrArg FundamentalGroupoid.mk he₁.symm) := by
      rw [FundamentalGroupoid.conj_eqToHom]
      exact cov.map_liftPathQuotient A e₀
    have hLm : (FundamentalGroupoid.map ⟨punctMap f _, cov.continuous⟩).map
        (⟦L⟧ : FundamentalGroupoid.mk e₁.1 ⟶ FundamentalGroupoid.mk e₁.1) =
        eqToHom (congrArg FundamentalGroupoid.mk he₁) ≫ (C' ^ k) ≫
          eqToHom (congrArg FundamentalGroupoid.mk he₁.symm) := by
      rw [← hcpk]
      refine Eq.trans ?_ (FundamentalGroupoid.conj_eqToHom
        (p := (⟦cpk⟧ : Path.Homotopic.Quotient _ _)) e₁.2 e₁.2).symm
      change Path.Homotopic.Quotient.mk (L.map cov.continuous) =
        (Path.Homotopic.Quotient.mk cpk).cast e₁.2 e₁.2
      rw [← Path.Homotopic.Quotient.mk_cast]
      congr 1
      ext t
      exact congrArg Subtype.val (hL₀ t)
    have hÃinv : (FundamentalGroupoid.map ⟨punctMap f _, cov.continuous⟩).map
        (Groupoid.inv Ã) = eqToHom (congrArg FundamentalGroupoid.mk he₁) ≫ Groupoid.inv A ≫
          eqToHom (congrArg FundamentalGroupoid.mk he₀.symm) := by
      have : (FundamentalGroupoid.map ⟨punctMap f _, cov.continuous⟩).map (Groupoid.inv Ã) =
          Groupoid.inv ((FundamentalGroupoid.map ⟨punctMap f _, cov.continuous⟩).map Ã) := by
        rw [Groupoid.inv_eq_inv, Functor.map_inv, Groupoid.inv_eq_inv]
      rw [this, hÃ]
      exact groupoid_inv_eqToHom_conj _ _ _
    change _ = eqToHom (congrArg FundamentalGroupoid.mk he₀.symm) ≫
      (FundamentalGroupoid.map ⟨punctMap f _, cov.continuous⟩).map
        (Ã ≫ ⟦L⟧ ≫ Groupoid.inv Ã) ≫ eqToHom (congrArg FundamentalGroupoid.mk he₀)
    rw [Functor.map_comp, Functor.map_comp, hÃ, hLm, hÃinv]
    exact (eqToHom_sandwich (C := FundamentalGroupoid X01) A (C' ^ k)
      (Groupoid.inv A) _ _).symm
  exact ⟨e₁.1, Ã, L, hall, hgL⟩

/-- The subgroup of the stabiliser normally generated by the elements conjugate in `F({0, 1})` to
a power of `x₀ x₁`: the cusp loops at infinity. -/
def inftySubgroup (e₀ : punctMap f ({0, 1} : Finset ℂ) ⁻¹' {x}) :
    Subgroup (MulAction.stabilizer (FreeGroup ({0, 1} : Finset ℂ)) e₀) :=
  Subgroup.normalClosure {h | ∃ (G : FreeGroup ({0, 1} : Finset ℂ)) (k : ℤ),
    (h : FreeGroup ({0, 1} : Finset ℂ)) = G * loop01 ^ k * G⁻¹}

include I in
/-- **Filling a branched covering of `ℂ ∖ {0, 1}` at `0`, `1` and at the point at infinity**:
the kernel of `π₁(X ∖ f⁻¹{0, 1}, e₀) → π₁(Y, e₀)` is the preimage of the subgroup generated by
the cusp subgroup and the cusp loops at infinity under `π₁(X ∖ f⁻¹{0, 1}, e₀) ≃* Stab(e₀)`. -/
theorem ker_eq_comap_cuspSubgroup_sup_infty [T1Space Y]
    [PathConnectedSpace (Punct f ({0, 1} : Finset ℂ))] (D : DiscData f ({0, 1} : Finset ℂ))
    (hj : IsEmbedding j) (hrange : range j = {p}ᶜ)
    (hψ : ∀ s : ({0, 1} : Finset ℂ), IsLoopAround (ψ.symm (FreeGroup.of s)) s)
    {R : ℝ} (hR : 1 / 2 < R) (hR₀ : I.R₀ < R) (hR₁ : I.R₁ < R)
    (hψinf : ∃ δ : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk (bigBase hR),
      ψ.symm loop01 = δ ≫ bigArrow hR ≫ Groupoid.inv δ)
    (e₀ : punctMap f ({0, 1} : Finset ℂ) ⁻¹' {x}) :
    (FundamentalGroup.map (punctIncl f j) e₀.1).ker =
      (cuspSubgroup (Set.univ : Set ({0, 1} : Finset ℂ)) e₀ ⊔ inftySubgroup e₀).comap
        (cov.fundamentalGroupEquivFreeStabilizer ψ hφ e₀).toMonoidHom := by
  haveI : T1Space X := hj.t1Space
  rw [(fill_infty D hj hrange I e₀.1).2, Subgroup.normalClosure_union,
    ← Subgroup.comap_sup_eq _ _ _ (cov.fundamentalGroupEquivFreeStabilizer ψ hφ e₀).surjective]
  congr 1
  · rw [← (fill D e₀.1).2]
    exact ker_eq_comap_cuspSubgroup D cov ψ hφ hψ e₀
  · rw [inftySubgroup, MulEquiv.toMonoidHom_eq_coe, ← Subgroup.comap_normalClosure]
    congr 1
    ext g
    simp only [Set.mem_preimage, Set.mem_setOf_eq]
    constructor
    · exact exists_eq_conj_of_mem_conjLoops_infty I cov ψ hφ hR hR₀ hψinf e₀
    · rintro ⟨G, k, hk⟩
      exact mem_conjLoops_infty_of_eq I cov ψ hφ hR hR₁ hψinf e₀ hk

end Main

end BranchedCover
