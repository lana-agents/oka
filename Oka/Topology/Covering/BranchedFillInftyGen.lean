import Oka.Topology.Covering.BranchedFillInfty
import Oka.Topology.VanKampen.LineExterior

/-!
# Filling the point at infinity of a branched covering of `ℂ ∖ S`

The generalisation of `Oka/Topology/Covering/BranchedFillInfty.lean` from `S = {0, 1}` to any
finite `S ⊆ ℂ` whose points lie within distance `ρ` of a centre `c`. Let `f : X → ℂ` be a
branched covering of the plane, unramified over `ℂ ∖ S`, with disc data at the points over `S`
(`BranchedCover.DiscData`), and let `j : X → Y` be an embedding onto `Y ∖ {p}` with disc data at
`p` near `∞` (`BranchedCover.Gen.InftyData`): a disc `V ∋ p` with
`f(V ∖ {p}) ⊆ {z | R₀ < ‖z - c‖}` for some `R₀ > ρ`, and `f⁻¹ {z | R₁ < ‖z - c‖} ⊆ V`.

Given a free basis of loops around the points of `S` (`ψ : π₁(ℂ ∖ S, x) ≃* F(S)`) and an element
`w ∈ F(S)` with `ψ⁻¹(w)` conjugate to the circle of radius `R > max R₀ R₁` around `c`, the kernel
of `π₁(X ∖ f⁻¹(S), e₀) → π₁(Y, e₀)` is the preimage, under `π₁(X ∖ f⁻¹(S), e₀) ≃* Stab(e₀)`, of
the subgroup generated by pi1's cusp subgroup and the normal closure of the elements of the
stabiliser conjugate to a power of `w` (`BranchedCover.Gen.ker_eq_comap_cuspSubgroup_sup_infty`).

## Proof

As for `S = {0, 1}`: `VanKampen.fill_finite` with `{p} ∪ j(f⁻¹(S))`; a loop in `V ∖ {p}` maps
into the exterior of the disc of radius `R₀` around `c`, hence is conjugate to a power of `w`
(`BranchedCover.Gen.exists_eq_conjArrow_zpow'`, from
`Complex.PuncturedPlane.Exterior.exists_eq_conj_zpow_circ`); conversely the closed lifts of powers
of the circle of radius `R > R₁` lie in `f⁻¹ {R₁ < ‖z - c‖} ⊆ V`.
-/

open Set Metric Topology CategoryTheory Complex.PuncturedPlane Complex.PuncturedPlane.LineBasis
  Pi1.ReidemeisterSchreier BranchedCover

namespace BranchedCover.Gen

universe u v

section Fill

variable {X : Type u} {Y : Type v} [TopologicalSpace X] [TopologicalSpace Y] {S : Finset ℂ} {c : ℂ}
  {ρ : ℝ}

/-- **Disc data at infinity** for `f : X → ℂ` and `j : X → Y`: a disc neighbourhood `V` of `p`
whose points other than `p` are mapped by `f` into the exterior `{z | R₀ < ‖z - c‖}`,
`R₀ > ρ`, and which contains the image of `f⁻¹ {z | R₁ < ‖z - c‖}`. -/
structure InftyData (f : C(X, ℂ)) (j : C(X, Y)) (p : Y) (c : ℂ) (ρ : ℝ) where
  /-- The disc neighbourhood of `p`. -/
  V : Set Y
  /-- The homeomorphism with the unit disc. -/
  e : V ≃ₜ ball (0 : ℂ) 1
  isOpen : IsOpen V
  mem : p ∈ V
  e_center : (e ⟨p, mem⟩ : ℂ) = 0
  /-- The radius of the exterior containing `f(V ∖ {p})`. -/
  R₀ : ℝ
  lt_R₀ : ρ < R₀
  mapsTo : ∀ u, j u ∈ V → R₀ < ‖f u - c‖
  /-- The radius of an exterior whose preimage lies in `V`. -/
  R₁ : ℝ
  cover : ∀ u, R₁ < ‖f u - c‖ → j u ∈ V

variable {f : C(X, ℂ)} {j : C(X, Y)} {p : Y}

/-- The inclusion `X ∖ f⁻¹(S) → Y`. -/
def punctIncl (f : C(X, ℂ)) (S : Finset ℂ) (j : C(X, Y)) : C(Punct f S, Y) :=
  j.comp ⟨Subtype.val, continuous_subtype_val⟩

theorem conjLoops_punctIncl_image (hj : IsEmbedding j) (V : Set X)
    (w₀ : Punct f S) :
    VanKampen.conjLoops (punctIncl f S j) (j '' V) w₀ = VanKampen.conjLoops Subtype.val V w₀ := by
  ext g
  simp only [VanKampen.conjLoops, mem_setOf_eq]
  refine exists_congr fun w ↦ exists_congr fun γ ↦ exists_congr fun c ↦ and_congr_left' ?_
  refine forall_congr' fun t ↦ ?_
  exact hj.injective.mem_set_image

/-- **Filling `f⁻¹(S)` and the point at infinity**: `π₁(X ∖ f⁻¹(S)) → π₁(Y)` is surjective
with kernel the normal closure of the loops in the discs over `S` and of the loops in the
disc at infinity. -/
theorem fill_infty [T1Space Y] [PathConnectedSpace (Punct f S)]
    (hS : ∀ s ∈ S, ‖s - c‖ ≤ ρ) (D : DiscData f S) (hj : IsEmbedding j) (hrange : range j = {p}ᶜ)
    (I : InftyData f j p c ρ) (e₀ : Punct f S) :
    Function.Surjective (FundamentalGroup.map (punctIncl f S j) e₀) ∧
      (FundamentalGroup.map (punctIncl f S j) e₀).ker =
        Subgroup.normalClosure ((⋃ P ∈ {P | f P ∈ S},
          VanKampen.conjLoops Subtype.val (D.V P) e₀) ∪
            VanKampen.conjLoops (punctIncl f S j) I.V e₀) := by
  classical
  haveI : Nonempty X := ⟨e₀.1⟩
  have hoj : IsOpenEmbedding j := ⟨hj, by rw [hrange]; exact isOpen_compl_singleton⟩
  set T := {P | f P ∈ S}
  set Z : Set Y := insert p (j '' T)
  let VY : Y → Set Y := fun q ↦ if q = p then I.V else j '' D.V (Function.invFun j q)
  have hinv : ∀ P, Function.invFun j (j P) = P := Function.leftInverse_invFun hj.injective
  have hpj : ∀ P, j P ≠ p := fun P h ↦ by
    have : j P ∈ range j := mem_range_self P
    rw [hrange, h] at this
    exact this rfl
  have hVj : ∀ P, VY (j P) = j '' D.V P := fun P ↦ by simp [VY, hpj P, hinv P]
  have hVp : VY p = I.V := by simp [VY]
  have hZT : ∀ q ∈ Z, q ≠ p → f (Function.invFun j q) ∈ S := by
    rintro q (rfl | ⟨P, hP, rfl⟩) hq
    · exact absurd rfl hq
    · rwa [hinv]
  have hVo : ∀ q ∈ Z, IsOpen (VY q) := by
    rintro q (rfl | ⟨P, hP, rfl⟩)
    · rw [hVp]; exact I.isOpen
    · rw [hVj]; exact hoj.isOpenMap _ (D.isOpen P hP)
  have hPV : ∀ q ∈ Z, q ∈ VY q := by
    rintro q (rfl | ⟨P, hP, rfl⟩)
    · rw [hVp]; exact I.mem
    · rw [hVj]; exact mem_image_of_mem j (D.mem P hP)
  let e : ∀ q ∈ Z, VY q ≃ₜ ball (0 : ℂ) 1 := fun q hq ↦
    if hqp : q = p then (Homeomorph.setCongr (by rw [hqp, hVp])).trans I.e
    else (Homeomorph.setCongr (show VY q = j '' D.V (Function.invFun j q) by simp [VY, hqp])).trans
      ((imageHomeo hj _).trans (D.e _ (hZT q hq hqp)))
  have he : ∀ q (hq : q ∈ Z), (e q hq ⟨q, hPV q hq⟩ : ℂ) = 0 := by
    intro q hq
    by_cases hqp : q = p
    · subst hqp
      simp only [e, dif_pos]
      exact I.e_center
    · simp only [e, dif_neg hqp]
      set Q := Function.invFun j q
      have hQ := hZT q hq hqp
      set y := imageHomeo hj (D.V Q) ⟨q, by simpa [VY, hqp] using hPV q hq⟩
      have hjQ : j Q = q := Function.invFun_eq (by
        obtain ⟨P, -, hP⟩ := hq.resolve_left hqp
        exact ⟨P, hP⟩)
      have hy : (y : X) = Q :=
        hj.injective ((apply_imageHomeo hj (D.V Q) _).trans hjQ.symm)
      have : y = ⟨Q, D.mem Q hQ⟩ := Subtype.ext hy
      change (D.e Q hQ y : ℂ) = 0
      rw [this]
      exact D.e_center Q hQ
  have hVZ : ∀ q ∈ Z, ∀ q' ∈ Z, q' ∈ VY q → q' = q := by
    rintro q (rfl | ⟨P, hP, rfl⟩) q' (rfl | ⟨P', hP', rfl⟩) hq'
    · rfl
    · rw [hVp] at hq'
      have h1 := I.mapsTo P' hq'
      have h2 := hS _ hP'
      linarith [I.lt_R₀]
    · rw [hVj] at hq'
      obtain ⟨u, -, hu⟩ := hq'
      exact absurd hu (hpj u)
    · rw [hVj, hj.injective.mem_set_image] at hq'
      rw [D.eq_of_mem P hP P' hq' hP']
  have hrange' : range (punctIncl f S j) = Zᶜ := by
    ext y
    simp only [mem_range, mem_compl_iff, Z, mem_insert_iff, mem_image, not_or, not_exists,
      not_and]
    constructor
    · rintro ⟨u, rfl⟩
      refine ⟨hpj u.1, fun P hP hPu ↦ u.2 ?_⟩
      exact (hj.injective hPu : P = u.1) ▸ hP
    · rintro ⟨hyp, hy⟩
      have : y ∈ range j := by rw [hrange]; exact hyp
      obtain ⟨u, rfl⟩ := this
      exact ⟨⟨u, fun hu ↦ hy u hu rfl⟩, rfl⟩
  have hemb : IsEmbedding (punctIncl f S j) := hj.comp IsEmbedding.subtypeVal
  obtain ⟨hs, hk⟩ := VanKampen.fill_finite (punctIncl f S j) hemb Z ((D.finite.image j).insert p)
    hrange' VY hVo hPV e he hVZ e₀
  refine ⟨hs, hk.trans (congrArg _ ?_)⟩
  rw [biUnion_insert, biUnion_image, hVp, union_comm]
  congr 1
  refine iUnion₂_congr fun P _ ↦ ?_
  rw [hVj, conjLoops_punctIncl_image hj]

end Fill

/-- A loop in the exterior `{R₀ < ‖z - c‖}` of `ℂ ∖ S` is conjugate to a power of any `X`
conjugate to the circle of radius `R > R₀` around `c`. -/
theorem exists_eq_conjArrow_zpow' {S : Finset ℂ} {c : ℂ} {ρ : ℝ} (hS : ∀ s ∈ S, ‖s - c‖ ≤ ρ)
    (hρ : 0 ≤ ρ) {R₀ R : ℝ} (hR₀ : ρ < R₀) (hR : R₀ < R) (h' : CircleIn Set.univ S c R) (φ : ℝ)
    {x : Region Set.univ S} {X : FundamentalGroup (Region Set.univ S) x}
    (hX : ∃ δ : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk (theta h' φ),
      X = δ ≫ ⟦circ h' φ⟧ ≫ Groupoid.inv δ)
    {z : Region Set.univ S} (γ : Path z z) (hγ : ∀ t, R₀ < ‖(γ t : ℂ) - c‖) :
    ∃ (k : ℤ) (α : FundamentalGroupoid.mk z ⟶ FundamentalGroupoid.mk x),
      (⟦γ⟧ : FundamentalGroupoid.mk z ⟶ FundamentalGroupoid.mk z) = conjArrow α (X ^ k) := by
  obtain ⟨δ, rfl⟩ := hX
  obtain ⟨k, α, hk⟩ := Exterior.exists_eq_conj_zpow_circ hS hρ hR₀ hR h' φ γ hγ
  refine ⟨k, α ≫ Groupoid.inv δ, ?_⟩
  rw [← conjArrow_apply, ← map_zpow, conjArrow_apply, conjArrow_apply, hk]
  simp [Groupoid.inv_eq_inv, Category.assoc]

section Main

variable {X : Type u} {Y : Type v} [TopologicalSpace X] [TopologicalSpace Y] {S : Finset ℂ} {c : ℂ}
  {ρ : ℝ} (hS : ∀ s ∈ S, ‖s - c‖ ≤ ρ) (hρ : 0 ≤ ρ) (w : FreeGroup S)
  {f : C(X, ℂ)} {j : C(X, Y)} {p : Y} (I : InftyData f j p c ρ)
  (cov : IsCoveringMap (punctMap f S)) {x : (Region Set.univ S)}
  (ψ : FundamentalGroup (Region Set.univ S) x ≃* FreeGroup S)
  [MulAction (FreeGroup S) (punctMap f S ⁻¹' {x})]
  (hφ : ∀ (g : FreeGroup S) (e : punctMap f S ⁻¹' {x}),
    g • e = cov.monodromy (ψ.symm g) e)

include hS hρ in
/-- The image in `π₁(ℂ ∖ S, x)` of a loop `γ c γ⁻¹` with `c` in the disc at infinity is
conjugate to a power of `w`. -/
theorem exists_eq_conj_of_mem_conjLoops_infty {R : ℝ} (h' : CircleIn Set.univ S c R) (φ : ℝ)
    (hR₀ : I.R₀ < R)
    (hψ : ∃ δ : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk (theta h' φ),
      ψ.symm w = δ ≫ ⟦circ h' φ⟧ ≫ Groupoid.inv δ)
    (e₀ : punctMap f S ⁻¹' {x})
    {g : FundamentalGroup (Punct f S) e₀.1}
    (hg : g ∈ VanKampen.conjLoops (punctIncl f S j) I.V e₀.1) :
    ∃ (G : FreeGroup S) (k : ℤ),
      (cov.fundamentalGroupEquivFreeStabilizer ψ hφ e₀ g : FreeGroup S) =
        G * w ^ k * G⁻¹ := by
  obtain ⟨w₁, γ, cl, hcl, rfl⟩ := hg
  let pc : Path (punctMap f _ w₁) (punctMap f _ w₁) := cl.map (punctMap f _).continuous
  have hpc : ∀ t, I.R₀ < ‖(pc t : ℂ) - c‖ := fun t ↦ I.mapsTo _ (hcl t)
  obtain ⟨k, α, hk⟩ := exists_eq_conjArrow_zpow' hS hρ I.lt_R₀ hR₀ h' φ hψ pc hpc
  set Xs := ψ.symm w
  have hx : FundamentalGroupoid.mk x = FundamentalGroupoid.mk (punctMap f _ e₀.1) :=
    congrArg FundamentalGroupoid.mk e₀.2.symm
  let Dd : FundamentalGroup (Region Set.univ S) x :=
    eqToHom hx ≫ (FundamentalGroupoid.map (punctMap f _)).map γ ≫ α
  have hmap : FundamentalGroup.mapOfEq ⟨punctMap f _, cov.continuous⟩ e₀.2
      (γ ≫ ⟦cl⟧ ≫ Groupoid.inv γ) = Dd⁻¹ * Xs ^ k * Dd := by
    change eqToHom hx ≫ (FundamentalGroupoid.map (punctMap f _)).map
      (γ ≫ ⟦cl⟧ ≫ Groupoid.inv γ) ≫ eqToHom hx.symm = Dd ≫ (Xs ^ k) ≫ Groupoid.inv Dd
    have hc' : (FundamentalGroupoid.map (punctMap f _)).map
        (⟦cl⟧ : FundamentalGroupoid.mk w₁ ⟶ FundamentalGroupoid.mk w₁) =
          α ≫ (Xs ^ k) ≫ Groupoid.inv α := hk.trans (conjArrow_apply _ _)
    rw [Functor.map_comp, Functor.map_comp, hc', Groupoid.inv_eq_inv γ, Functor.map_inv]
    simp only [Dd, Groupoid.inv_eq_inv, IsIso.inv_comp, inv_eqToHom, Category.assoc]
    erw [Category.assoc, Category.assoc, Category.assoc, Category.assoc]
    rfl
  refine ⟨(ψ Dd)⁻¹, k, ?_⟩
  rw [coe_fundamentalGroupEquivFreeStabilizer, hmap, map_mul, map_mul, map_inv, map_zpow,
    MulEquiv.apply_symm_apply, inv_inv]

/-- A conjugate of a power of `w` lying in the stabiliser comes from a loop `γ c γ⁻¹` with
`c` in the disc at infinity. -/
theorem mem_conjLoops_infty_of_eq {R : ℝ} (hR0 : 0 ≤ R) (h' : CircleIn Set.univ S c R) (φ : ℝ)
    (hR₁ : I.R₁ < R)
    (hψ : ∃ δ : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk (theta h' φ),
      ψ.symm w = δ ≫ ⟦circ h' φ⟧ ≫ Groupoid.inv δ)
    (e₀ : punctMap f S ⁻¹' {x})
    {g : FundamentalGroup (Punct f S) e₀.1}
    {G : FreeGroup S} {k : ℤ}
    (hg : (cov.fundamentalGroupEquivFreeStabilizer ψ hφ e₀ g : FreeGroup S) =
      G * w ^ k * G⁻¹) :
    g ∈ VanKampen.conjLoops (punctIncl f S j) I.V e₀.1 := by
  obtain ⟨δ, hX⟩ := hψ
  let C' : FundamentalGroup (Region Set.univ S) (theta h' φ) :=
    FundamentalGroup.fromPath (.mk (circ h' φ))
  set Gh := ψ.symm G
  let A : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk (theta h' φ) :=
    Groupoid.inv Gh ≫ δ
  -- the image of `g` in `π₁(ℂ ∖ S, x)`
  have hpg : FundamentalGroup.mapOfEq ⟨punctMap f _, cov.continuous⟩ e₀.2 g =
      A ≫ (C' ^ k) ≫ Groupoid.inv A := by
    have h1 : FundamentalGroup.mapOfEq ⟨punctMap f _, cov.continuous⟩ e₀.2 g =
        Gh * ψ.symm w ^ k * Gh⁻¹ := by
      apply ψ.injective
      rw [← coe_fundamentalGroupEquivFreeStabilizer cov ψ hφ, hg, map_mul, map_mul, map_zpow,
        map_inv, MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply]
    have h2 : ψ.symm w = Complex.PuncturedPlane.conjArrow δ C' := by
      rw [hX, conjArrow_apply]
      rfl
    rw [h1, h2, ← map_zpow, conjArrow_apply]
    change Groupoid.inv Gh ≫ (δ ≫ (C' ^ k) ≫ Groupoid.inv δ) ≫ Gh = _
    simp only [A, Groupoid.inv_eq_inv, IsIso.inv_comp, IsIso.inv_inv, Category.assoc]
  clear_value A
  -- the lift `e₁` of the base point of the circle and the closed lift of `C'ᵏ`
  set e₁ := cov.monodromy A e₀
  have hstab : cov.monodromy (FundamentalGroup.mapOfEq ⟨punctMap f _, cov.continuous⟩ e₀.2 g)
      e₀ = e₀ :=
    (cov.mem_monodromyStabilizer_iff_mem_range e₀ _).mpr ⟨g, rfl⟩
  have hinv : cov.monodromy (Groupoid.inv A) e₁ = e₀ := by
    rw [← cov.monodromy_trans_apply]
    change cov.monodromy (A ≫ Groupoid.inv A) e₀ = e₀
    rw [Groupoid.comp_inv]
    exact congrFun cov.monodromy_refl e₀
  have hmono : cov.monodromy (C' ^ k) e₁ = e₁ := by
    apply (cov.monodromy_bijective (Groupoid.inv A)).1
    rw [hinv, ← cov.monodromy_trans_apply, ← cov.monodromy_trans_apply]
    change cov.monodromy (A ≫ (C' ^ k) ≫ Groupoid.inv A) e₀ = e₀
    rw [← hpg]
    exact hstab
  let cpk : Path (theta h' φ) (theta h' φ) := (circ h' φ).zpowLoop k
  have hcpk : (⟦cpk⟧ : FundamentalGroupoid.mk (theta h' φ) ⟶ _) = C' ^ k :=
    (circ h' φ).class_zpowLoop k
  have hcpkB : ∀ t, I.R₁ < ‖(cpk t : ℂ) - c‖ := by
    intro t
    obtain ⟨t', ht'⟩ := (circ h' φ).mem_range_zpowLoop k t
    rw [← ht']
    change I.R₁ < ‖thetaFun c R (φ + 2 * Real.pi * t') - c‖
    rw [norm_thetaFun_sub c hR0 _]
    exact hR₁
  have h0 : cpk.toContinuousMap 0 = punctMap f _ e₁.1 := cpk.source.trans e₁.2.symm
  let L₀ := cov.liftPath cpk.toContinuousMap e₁.1 h0
  have hL₀ : ∀ t, punctMap f _ (L₀ t) = cpk t := fun t ↦
    congrFun (cov.liftPath_lifts cpk.toContinuousMap e₁.1 h0) t
  have hL₁ : L₀ 1 = e₁.1 := by
    have : (cov.monodromy (⟦cpk⟧ : Path.Homotopic.Quotient _ (theta h' φ)) e₁).1 = L₀ 1 := rfl
    rw [← this]
    change (cov.monodromy (⟦cpk⟧ : FundamentalGroupoid.mk (theta h' φ) ⟶ _) e₁).1 = e₁.1
    rw [hcpk]
    exact congrArg Subtype.val hmono
  let L : Path e₁.1 e₁.1 := ⟨L₀, cov.liftPath_zero .., hL₁⟩
  have hall : ∀ t, punctIncl f S j (L t) ∈ I.V := fun t ↦ by
    refine I.cover _ ?_
    have := hL₀ t
    have hfe : (punctMap f _ (L₀ t) : ℂ) = f (L₀ t).1 := rfl
    change I.R₁ < ‖f (L₀ t).1 - c‖
    rw [← hfe, this]
    exact hcpkB t
  -- `g` is the lift `Ã ≫ L ≫ Ã⁻¹`
  let Ã : FundamentalGroupoid.mk e₀.1 ⟶ FundamentalGroupoid.mk e₁.1 := cov.liftPathQuotient A e₀
  have he₀ : punctMap f _ e₀.1 = x := e₀.2
  have he₁ : punctMap f _ e₁.1 = theta h' φ := e₁.2
  have hgL : g = Ã ≫ ⟦L⟧ ≫ Groupoid.inv Ã := by
    apply cov.mapOfEq_injective e₀
    rw [hpg]
    have hÃ : (FundamentalGroupoid.map ⟨punctMap f _, cov.continuous⟩).map Ã =
        eqToHom (congrArg FundamentalGroupoid.mk he₀) ≫ A ≫
          eqToHom (congrArg FundamentalGroupoid.mk he₁.symm) := by
      rw [FundamentalGroupoid.conj_eqToHom]
      exact cov.map_liftPathQuotient A e₀
    have hLm : (FundamentalGroupoid.map ⟨punctMap f _, cov.continuous⟩).map
        (⟦L⟧ : FundamentalGroupoid.mk e₁.1 ⟶ FundamentalGroupoid.mk e₁.1) =
        eqToHom (congrArg FundamentalGroupoid.mk he₁) ≫ (C' ^ k) ≫
          eqToHom (congrArg FundamentalGroupoid.mk he₁.symm) := by
      rw [← hcpk]
      refine Eq.trans ?_ (FundamentalGroupoid.conj_eqToHom
        (p := (⟦cpk⟧ : Path.Homotopic.Quotient _ _)) e₁.2 e₁.2).symm
      change Path.Homotopic.Quotient.mk (L.map cov.continuous) =
        (Path.Homotopic.Quotient.mk cpk).cast e₁.2 e₁.2
      rw [← Path.Homotopic.Quotient.mk_cast]
      congr 1
      ext t
      exact congrArg Subtype.val (hL₀ t)
    have hÃinv : (FundamentalGroupoid.map ⟨punctMap f _, cov.continuous⟩).map
        (Groupoid.inv Ã) = eqToHom (congrArg FundamentalGroupoid.mk he₁) ≫ Groupoid.inv A ≫
          eqToHom (congrArg FundamentalGroupoid.mk he₀.symm) := by
      have : (FundamentalGroupoid.map ⟨punctMap f _, cov.continuous⟩).map (Groupoid.inv Ã) =
          Groupoid.inv ((FundamentalGroupoid.map ⟨punctMap f _, cov.continuous⟩).map Ã) := by
        rw [Groupoid.inv_eq_inv, Functor.map_inv, Groupoid.inv_eq_inv]
      rw [this, hÃ]
      exact groupoid_inv_eqToHom_conj _ _ _
    change _ = eqToHom (congrArg FundamentalGroupoid.mk he₀.symm) ≫
      (FundamentalGroupoid.map ⟨punctMap f _, cov.continuous⟩).map
        (Ã ≫ ⟦L⟧ ≫ Groupoid.inv Ã) ≫ eqToHom (congrArg FundamentalGroupoid.mk he₀)
    rw [Functor.map_comp, Functor.map_comp, hÃ, hLm, hÃinv]
    exact (eqToHom_sandwich (C := FundamentalGroupoid (Region Set.univ S)) A (C' ^ k)
      (Groupoid.inv A) _ _).symm
  exact ⟨e₁.1, Ã, L, hall, hgL⟩

/-- The subgroup of the stabiliser normally generated by the elements conjugate in `F(S)` to
a power of `w`: the cusp loops at infinity. -/
def inftySubgroup (e₀ : punctMap f S ⁻¹' {x}) :
    Subgroup (MulAction.stabilizer (FreeGroup S) e₀) :=
  Subgroup.normalClosure {h | ∃ (G : FreeGroup S) (k : ℤ),
    (h : FreeGroup S) = G * w ^ k * G⁻¹}

include I hS hρ in
/-- **Filling a branched covering of `ℂ ∖ S` at `0`, `1` and at the point at infinity**:
the kernel of `π₁(X ∖ f⁻¹(S), e₀) → π₁(Y, e₀)` is the preimage of the subgroup generated by
the cusp subgroup and the cusp loops at infinity under `π₁(X ∖ f⁻¹(S), e₀) ≃* Stab(e₀)`. -/
theorem ker_eq_comap_cuspSubgroup_sup_infty [T1Space Y]
    [PathConnectedSpace (Punct f S)] (D : DiscData f S)
    (hj : IsEmbedding j) (hrange : range j = {p}ᶜ)
    (hψ : ∀ s : S, IsLoopAround (ψ.symm (FreeGroup.of s)) s)
    {R : ℝ} (hρR : ρ < R) (h' : CircleIn Set.univ S c R) (φ : ℝ) (hR₀ : I.R₀ < R)
    (hR₁ : I.R₁ < R)
    (hψinf : ∃ δ : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk (theta h' φ),
      ψ.symm w = δ ≫ ⟦circ h' φ⟧ ≫ Groupoid.inv δ)
    (e₀ : punctMap f S ⁻¹' {x}) :
    (FundamentalGroup.map (punctIncl f S j) e₀.1).ker =
      (cuspSubgroup (Set.univ : Set S) e₀ ⊔ inftySubgroup w e₀).comap
        (cov.fundamentalGroupEquivFreeStabilizer ψ hφ e₀).toMonoidHom := by
  haveI : T1Space X := hj.t1Space
  rw [(fill_infty hS D hj hrange I e₀.1).2, Subgroup.normalClosure_union,
    ← Subgroup.comap_sup_eq _ _ _ (cov.fundamentalGroupEquivFreeStabilizer ψ hφ e₀).surjective]
  congr 1
  · rw [← (fill D e₀.1).2]
    exact ker_eq_comap_cuspSubgroup D cov ψ hφ hψ e₀
  · rw [inftySubgroup, MulEquiv.toMonoidHom_eq_coe, ← Subgroup.comap_normalClosure]
    congr 1
    ext g
    simp only [Set.mem_preimage, Set.mem_setOf_eq]
    constructor
    · exact exists_eq_conj_of_mem_conjLoops_infty hS hρ w I cov ψ hφ h' φ hR₀ hψinf e₀
    · rintro ⟨G, k, hk⟩
      exact mem_conjLoops_infty_of_eq w I cov ψ hφ (hρ.trans hρR.le) h' φ hR₁ hψinf e₀ hk

end Main

